{
  "name": "ground-delta-worker",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute ground-delta-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute ground-delta-db --remote --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^3.78.0"
  }
}
